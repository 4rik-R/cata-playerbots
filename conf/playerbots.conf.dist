[playerbots]

# Read-only console factory inspection. Requires the optional auth schema in
# sql/auth/001_factory_ownership.sql and explicit dedicated-account evidence.
# This does not enable account enrollment, character creation or admission.
Playerbots.Factory.InspectionEnabled = 0

# Console-only explicit dedication of pre-created, empty ordinary accounts,
# followed by native create or exact-identity accounting recovery. Requires the
# optional auth schema. Enables inspection too; never auto-admits or grants
# player control. No automatic account creation/population/deletion.
Playerbots.Factory.Enabled = 0

# MultiBot transport: HELLO, PING, active ROSTER, managed ALT_ROSTER and lifecycle.
# Managed mutations also require the Managed settings and account authorization.
# Only ALT_ROSTER_V1/BOT_LIFECYCLE_V1 are advertised when player lifecycle is enabled.
Playerbots.MultiBot.Enabled = 0

# Optional mod-playerbots configuration. These values override legacy options
# in worldserver.conf. Missing files retain legacy settings and compiled defaults.

#
#    Playerbots.Dev.Enabled
#        Description: Enables the isolated server-origin development bots.
#                     All configured bot accounts are reserved from human-client login while enabled.
#                     This is a manual development control, not a bot population system.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbots.Dev.Enabled = 0

# Console-only disposable level-20 role fixture preparation. Only configured
# slots; native map-thread talents/equipment/items, no population or DB edits.
# Never enable on a production realm. See the matching core's party fixture.
Playerbots.Dev.Fixture20.Enabled = 0

#
#    Playerbots.Dev.GreetingOnJoin
#        Description: Have an admitted Playerbot whisper a short greeting when
#                     it accepts an eligible human player's party invitation.
#        Default:     1 - (Enabled while Playerbots.Dev.Enabled is on)

Playerbots.Dev.GreetingOnJoin = 1

#
#    Playerbots.Dev.EngineWarriorBuff
#        Description: Experimental Warrior out-of-combat Battle Shout path via
#                     the imported Playerbots engine. Replaces only the existing
#                     Battle Shout maintenance call; does not enable combat AI.
#                     Requires a server restart to compare paths reliably.
#        Default:     0 - (Existing companion buff behavior)

Playerbots.Dev.EngineWarriorBuff = 0

# Route Mage Brilliance/Priest Fortitude party upkeep through the existing
# class engine instead of the direct fallback. Native Cata aura/cast checks
# are unchanged. No new spells, armor preference or autonomous behavior.
# Default: 0 (existing upkeep). Restart to compare paths reliably.
Playerbots.Dev.EnginePartyBuff = 0

# Optional donor-shaped carried food/drink recovery for supported companion classes.
# Uses native item use; no item creation, cheats, purchases or population automation.
# Starts below 40% health / 20% mana, pauses follow, resumes on completion/interruption.
# Default-off pending the next bundled mixed-party client check.
Playerbots.Rest.Enabled = 0

# Optional carried, instant healing/mana potions in combat for supported classes.
# Donor defaults: below 25% health / 40% mana. Native item cooldowns/consumption apply.
# Prefers carried native Healthstones, falling back to healing potions.
# No grants, direct restoration or flask use. Default-off pending replay.
Playerbots.Potions.Enabled = 0

# Optional spec-aware Mage self-armor upkeep through the existing engine.
# Arcane prefers Mage Armor; other/unspecialized bots prefer Molten Armor.
# Falls back to learned Mage/Frost Armor; never grants an unlearned spell.
# Default-off pending the next bundled mixed-party client check.
Playerbots.Mage.Armor.Enabled = 0

# Temporary native auto-pass policy until equipment-aware donor roll evaluation
# is ported. Applies to new Group Loot / Need Before Greed rolls, not existing rolls.
# Does not loot corpses, award items or change another player's preference.
# Disabling restores each companion's preference from before this feature enabled.
# Default-off pending a bundled party loot check.
Playerbots.Loot.PassOnGroupLoot = 0

# Initial nearby-corpse looting through native permissions, money and item storage.
# Keeps up to eight defeated/selected corpse GUIDs, expiring after 60 seconds.
# Short native-pathfinding detours: at most 15 yards from bot / 20 from owner,
# with a ten-second timeout. No area scans or roaming to distant loot.
# Currency, gathering, skinning and equipment-aware loot policies are not included.
# Native inventory failures use bounded 30-second per-corpse attempt backoff.
# Default-off pending the bundled mixed-party loot/recovery check.
Playerbots.Loot.Corpses.Enabled = 0

#
#    Playerbots.Dev.EngineWarriorCombat
#        Description: Experimental Warrior combat route through the imported
#                     Playerbots engine. Protection talents use a bounded tank
#                     strategy with party-target Taunt; other or unset trees
#                     use a generic low-level melee fallback. Replaces only
#                     the existing Warrior spell priority. Restart to compare.
#        Default:     0 - (Existing companion Warrior behavior)

Playerbots.Dev.EngineWarriorCombat = 0

#
#    Playerbots.Dev.EngineMageCombat
#        Description: Experimental Mage combat route through the imported
#                     Playerbots engine. Frost talents use the bounded Frost
#                     strategy; other or unset trees use the generic fallback.
#                     This replaces only the existing Mage spell priority.
#                     Restart to compare paths reliably.
#        Default:     0 - (Existing companion Mage behavior)

Playerbots.Dev.EngineMageCombat = 0

#
#    Playerbots.Dev.EnginePriestHeal
#        Description: Experimental Priest party-healing route through the
#                     imported Playerbots engine. Uses the Cata-validated
#                     Shield, Flash Heal, Heal and Renew spell set. Also enables
#                     out-of-combat Priest Resurrection for nearby dead party
#                     members and party-bot acceptance of resurrection offers.
#                     Includes disease cures and conservative healer damage:
#                     Shadow Word: Pain, Holy Fire, Smite and Mind Blast.
#                     controller fighting, nearby party health >=90%, mana >=85%.
#                     Does not enable a complete talent rotation.
#                     Restart to compare paths reliably.
#        Default:     0 - (Existing companion Priest healing)

Playerbots.Dev.EnginePriestHeal = 0

#
#    Playerbots.Dev.AccountId
#        Description: Dedicated ordinary-player account used only by PB-00.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId = 0

#
#    Playerbots.Dev.CharacterGuid
#        Description: Offline Warrior, Mage, or Priest GUID owned by Playerbots.Dev.AccountId.
#        Default:     0 - (Not configured)

Playerbots.Dev.CharacterGuid = 0

#
#    Playerbots.Dev.AccountId2
#        Description: Optional second dedicated ordinary-player account; must differ from AccountId.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId2 = 0

#
#    Playerbots.Dev.CharacterGuid2
#        Description: Offline Warrior, Mage, or Priest GUID owned by AccountId2;
#                     must differ from CharacterGuid.
#        Default:     0 - (Not configured)

Playerbots.Dev.CharacterGuid2 = 0

#
#    Playerbots.Dev.AccountId3 / Playerbots.Dev.CharacterGuid3
#    Playerbots.Dev.AccountId4 / Playerbots.Dev.CharacterGuid4
#        Description: Optional third and fourth dedicated ordinary-player bot slots.
#                     Supported classes are Warrior, Mage, and Priest.
#                     Every configured account and character GUID must be distinct.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId3 = 0
Playerbots.Dev.CharacterGuid3 = 0
Playerbots.Dev.AccountId4 = 0
Playerbots.Dev.CharacterGuid4 = 0

#
#    Playerbots.Managed.Enabled
#        Description: Permit console-managed admission of existing characters.
#                     No characters are connected automatically at startup.
#                     Listing and stopping configured bots remain available
#                     when admission is disabled.
#        Default:     0 - (Disabled)

Playerbots.Managed.Enabled = 0

#
#    Playerbots.Managed.Characters
#        Description: Comma-separated accountId:characterGuid pairs, for example
#                     101:2001,102:2002. Each account and character must be unique.
#                     Characters must already exist and pass native admission checks.
#                     This identifies managed accounts, not their party controllers.
#        Default:     (empty)

Playerbots.Managed.Characters =

# Player-facing lifecycle service. Requires an addon/command transport; the
# current ordinary whispers still control only admitted bots. Disabled by default.
# Managed.Enabled also gates new starts; stopping/listing do not require it.
Playerbots.Managed.AllowPlayerControl = 0

# Comma-separated humanAccountId:botAccountId trusted links, e.g. 1:101,1:102.
# Links are directional; each pair must be unique and use distinct positive IDs.
# At most 256 pairs. These grant lifecycle access, not automatic party control.
# Normal players must share faction; stopping a grouped bot also requires its
# current party control. GMs bypass links/faction/party checks while this service
# is enabled. Invalid links disable player access; console controls remain usable.
Playerbots.Managed.AccountLinks =

# Native leader/assistant ready checks: operational state and carried supplies.
# Requires alive, idle, no transfer/cast/rebuff, HP >85%, MP >65% for mana users,
# and initiator on the same map within 100 yards. Usable food/healing potions
# required; mana users also need actual drink/mana potions. No encounter or full
# buff-coverage guarantee. Replies expire after 30 seconds. Disabled by default.
Playerbots.ReadyCheck.Enabled = 0

# Optional donor-style rebuff before answering a native ready check. Requires
# ReadyCheck.Enabled and existing supported Mage/Priest party-buff/controller
# eligibility. Waits only within the native check's 30-second lifetime. Missing
# supplies or failed/canceled passes never become a ready response.
Playerbots.ReadyCheck.ForceRebuff = 0

# Ground-only controller mount coordination. Requires native level/riding and an
# eligible learned mount; does not grant training/spells. Native follow/casting
# remain authoritative. No flight, travel forms, vehicles, item mounts or BGs.
# Only this adapter's own mount cast/aura is canceled when yielding to control.
Playerbots.Mount.Ground.Enabled = 0

# Saved-position stay for an attached controller. Disabled keeps the old hold
# alias. Hold remains plain stop; follow/control/lifecycle changes clear anchors.
# Native ground pathing only; no combat stay, ghost travel or persistence.
Playerbots.Movement.Stay.Enabled = 0

# Bounded ordinary whisper/party strategy controls. co/nc/de query registrations;
# co focus/threat/potions and nc food/loot accept +, -, ~. Roles/specs/stay are protected. Changes are
# session-local, require an attached authorized controller and safe idle state.
# Does not enable globally disabled recovery/loot; disabling this restores class defaults.
# Addon mutation requires the separate option below.
Playerbots.StrategyControl.Enabled = 0

# Structured MultiBot mutation acknowledgements. Requires StrategyControl.Enabled.
# BOT scope: C focus/threat/potions, N food/loot operators; unsupported requests
# explicitly reject. No role overrides or persistence.
Playerbots.StrategyControl.AddonMutations = 0

# Opt-in bounded group mutations; also requires Enabled and AddonMutations.
# ALL = authorized controlled bots; GROUP/PARTY = current group (including raid);
# RAID = current raid. Maximum 128 bots, 32 pending batches, one per account.
# ACK follows execution or timeout. Unresolved timeout outcomes are unknown:
# refresh STATE before retrying a toggle. No rollback or automatic retry.
Playerbots.StrategyControl.GroupMutations = 0

# Donor automatic healer mana conservation for the currently ported Priest heals.
# Below/equal to 60% mana, preserve donor efficiency/overheal guards and tank
# exceptions. Estimates are scheduling hints; native Cata spells still heal.
# Optional until qualified under sustained party pressure. Default: disabled.
Playerbots.Healing.SaveMana.Enabled = 0

# Read-only experimental donor-derived gear score for level 10-39 Warrior,
# Mage and Holy/Discipline Priest. Cata intellect contribution is included;
# mastery/legacy tank ratings and incomplete item inputs stay unavailable.
# Not an optimal/BiS model. Does not equip gear, purchase items or roll on loot.
Playerbots.Equipment.StarterScore.Enabled = 0

# Explicit gear apply command: at most one safe native inventory change while idle.
# Requires StarterScore. No automatic gear loop, purchases, bags or loot votes.
Playerbots.Equipment.StarterEquip.Enabled = 0

# Optional native party rolls for supported starter gear/consumables. Actual
# native gear affixes require validated property/suffix/factor and known effects.
# Requires StarterScore; PassOnGroupLoot must be disabled. Unknown items pass.
# No automatic equipping, recipe/token/profession/disenchant classification.
Playerbots.Loot.Rolls.Enabled = 0

# Disposable role fixture only: preserve the Protection bot's chest in a bag
# and leave its slot empty for a deterministic native loot-need check.
# Requires Dev.Enabled and Dev.Fixture20.Enabled. Never normal provisioning.
Playerbots.Dev.LootRollFixture.Enabled = 0

# Accept ordinary shares and native party-pushed accept confirmations from the attached human controller while
# idle, alive and together in one party/map. Native eligibility/capacity and
# quest scripts remain authoritative. No NPC discovery, rewards or travel.
# Turn-in dialogs are not handled by this gate.
Playerbots.Quest.AcceptShared.Enabled = 0

# Explicit accept <quest ID> whisper/party command for the human's selected
# nearby creature/gameobject quest giver. One native operation per bot; queued
# intent expires after 5 seconds and rechecks authority/map/instance/interaction.
# No accept-all, quest links, item/self givers, reward or direct AddQuest fallback.
Playerbots.Quest.AcceptNpc.Enabled = 0

# Explicit reward <quest ID> <item ID> from the selected nearby quest giver.
# Item 0 only for quests without choice items. Ordinary completed, non-repeatable
# quests only; native checks grant rewards. No auto-selection or forced completion.
Playerbots.Quest.Reward.Enabled = 0

# Read-only quests whisper/party report: up to 25 active quests, native status,
# carried item counts, native kill/GO counters and reward choice item IDs.
# No travel, automatic completion or reward; independent of mutation gates.
Playerbots.Quest.Inspection.Enabled = 0

# Explicit share <quest ID> whisper to one controlled bot in the human's party.
# Native sharing rules apply to all recipients; submission is not acceptance.
# No automatic share loop or automatic bot-to-bot consent.
Playerbots.Quest.Share.Enabled = 0

# Explicit drop <active quest ID> whisper to one controlled bot. Native abandon
# rules may remove quest-provided items. No bulk cleanup or rewarded-history reset.
# Separate destructive-operation opt-in; not required for ordinary quest play.
Playerbots.Quest.Abandon.Enabled = 0

# Narrow donor master-quest loot priority: defer native quest-class corpse items
# while the human controller HasQuestForItem; native per-player drops are exempt.
# No reservation/transfer, rolls,
# broad item-usage override or quest progress edits. Default: disabled.
Playerbots.Quest.SyncLootWithPlayer.Enabled = 0
# Optional passive engine diagnostics: 64 records/session, 60-second retention.
# Engine/action-method outcomes only; not spell landing or complete decision coverage.
Playerbots.Diagnostics.Actions.Enabled = 0

# Explicit whisper/party repair at the human's selected nearby repair NPC.
# Uses native repair-all and the bot's own funds; no guild-bank or money cheat.
Playerbots.Maintenance.Repair.Enabled = 0

#
#    Playerbots.Random.Enabled
#        Description: Automatic random population. Creates up to Count dedicated
#                     accounts (AccountPrefix + 001, 002, ...) with an unstored random
#                     password, one native character each (Warrior/Mage/Priest of
#                     races without phased starting areas), and admits them in
#                     batches as server-origin sessions. Bots idle where they log in.
#                     Requires Playerbots.Managed.Enabled = 1 (core admission gate).
#                     Lowering Count logs surplus bots out; nothing is deleted.
#        Default:     0 - (Disabled)

Playerbots.Random.Enabled = 0

#    Playerbots.Random.Count             Target population (0-2000). Default 50.
#    Playerbots.Random.AccountPrefix     1-10 letters/digits. Default RNDBOT.
#    Playerbots.Random.LoginPerInterval  Admissions per interval (1-100). Default 10.
#    Playerbots.Random.IntervalSeconds   Manager pass interval (1-600). Default 20.
#    Playerbots.Random.AllianceRatio     Percent of new characters that are Alliance. Default 50.
#    Playerbots.Random.Classes           Class ids new characters may roll, comma separated:
#                                        1 Warrior, 3 Hunter, 4 Rogue, 5 Priest, 8 Mage, 9 Warlock.
#                                        Empty: all of them. Existing characters keep their class.

Playerbots.Random.Count = 50
Playerbots.Random.AccountPrefix = "RNDBOT"
Playerbots.Random.LoginPerInterval = 10
Playerbots.Random.IntervalSeconds = 20
Playerbots.Random.AllianceRatio = 50
Playerbots.Random.Classes = ""

#    Playerbots.Random.Grind.Enabled
#        Description: Ungrouped random bots act on their own: wander near their
#                     login spot, attack normal creatures of a fitting level
#                     (bot level -3 to +1), sit until health/mana recover, loot
#                     (needs the corpse-loot gate) and revive in place 30 seconds
#                     after death. Inviting a bot or giving a follow command hands
#                     control back to the player. Requires Playerbots.Random.Enabled.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbots.Random.Grind.Enabled = 0

#    Playerbots.Random.Level.Enabled
#        Description: Random bots get a stable target level between Min and Max.
#                     A fresh bot (below level 6) is raised to it with its class
#                     trainer spells, talents of a fixed spec, green gear (blue at
#                     85), bags, food/water, riding at 20 and some gold, then sent to
#                     a grind spot in a levelling zone of its faction. Bots keep
#                     levelling while grinding and move on when their zone no
#                     longer fits. Requires Playerbots.Random.Enabled.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)
#
#    Playerbots.Random.Level.Min / Max   Level range, 1-85. Default 1 and 85.

Playerbots.Random.Level.Enabled = 0
Playerbots.Random.Level.Min = 1
Playerbots.Random.Level.Max = 85
